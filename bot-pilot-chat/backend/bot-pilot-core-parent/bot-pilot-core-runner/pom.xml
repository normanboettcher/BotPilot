<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>de.botpilot</groupId>
        <artifactId>bot-pilot-core-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>bot-pilot-core-runner</artifactId>
    <name>bot-pilot-core-runner</name>


    <description>
        Spring Boot application assembler — the composition root.

        This is the ONLY module that:
        1. Declares @SpringBootApplication
        2. Knows about all adapter implementations simultaneously
        3. Wires ports to adapters via @Configuration + @Bean

        No business logic lives here. The module only collects all the pieces from the
        other modules and assembles them together.

        The spring-boot-maven-plugin repackage goal runs only here to produce the
        executable fat JAR (all other modules produce plain JARs).
    </description>
    <dependencies>
        <!-- bot-pilot-connectors -->
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-connectors-calendar-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-application</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-infrastructure-persistence
            </artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-infrastructure-vault
            </artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-infrastructure-google-api
            </artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-google-calendar-connector-rest</artifactId>
        </dependency>

        <!-- bot-pilot-faqs -->
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-application</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-infrastructure-json</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-infrastructure-nlp</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-api</artifactId>
        </dependency>

        <!-- Spring Boot Web: embedded Tomcat + DispatcherServlet -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Actuator: health + info endpoints for readiness checks -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Liquibase: schema migrations, run automatically at startup by Spring Boot's
             SpringLiquibase auto-configuration AFTER the DataSource bean exists — i.e.
             after Spring Cloud Vault has injected the dynamic DB credentials.
             Version is managed by the imported spring-boot-dependencies BOM.
             The runner owns the changelogs (src/main/resources/db/changelog) because the
             schema is a deployment concern of the assembled application, not of any
             single bounded-context module.

             Spring Boot 4 note: this MUST be spring-boot-starter-liquibase, not a bare
             org.liquibase:liquibase-core. Boot 4 split auto-configuration into per-technology
             modules, and the Liquibase auto-configuration now lives in spring-boot-liquibase,
             which the starter pulls in and liquibase-core does not. With only liquibase-core
             on the classpath the application still starts — it just never runs a migration. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-liquibase</artifactId>
        </dependency>

        <!-- ============================================================
             Test dependencies

             The runner is the only module that assembles a Spring context, so it is
             the only module that can meaningfully verify the context boots.
             ============================================================ -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- H2 backs the fast context test as a throwaway stand-in DataSource.
             It is NEVER used to verify migrations: the changesets are native MariaDB
             DDL, and H2's MariaDB compatibility mode would either reject them or,
             worse, accept them with different semantics and report a false pass.
             Migration fidelity is LiquibaseMigrationIT's job, against a real MariaDB. -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers: real, disposable MariaDB for the migration IT.
             Versions come from the Boot BOM (which imports testcontainers-bom). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mariadb</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <!-- Only the app module produces an executable fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Activates the *IT execution configured in the parent's pluginManagement.
                 Declared only here because this is the only module with integration tests. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
            </plugin>
        </plugins>
    </build>

</project>
