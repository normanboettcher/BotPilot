<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>de.botpilot</groupId>
        <artifactId>bot-pilot-faqs</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>bot-pilot-faqs-app</artifactId>
    <name>bot-pilot-faqs-app</name>
    <description>
        Spring Boot application assembler.
        The only module that depends on ALL other modules.
        Wires ports to adapters via @Configuration + @Bean.
        This is the only module with @SpringBootApplication.
    </description>

    <dependencies>
        <!-- All sibling modules — this module is the only one that knows about all adapters -->
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-application</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-infrastructure-json</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-infrastructure-nlp</artifactId>
        </dependency>
        <dependency>
            <groupId>de.botpilot</groupId>
            <artifactId>bot-pilot-faqs-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Only the app module produces an executable fat JAR -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
