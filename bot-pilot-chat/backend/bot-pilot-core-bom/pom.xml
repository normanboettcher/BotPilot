<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Bill of Materials (BOM): this POM's only job is to declare the canonical
        version for every dependency used across the bot-pilot microservices.
        No module declares it in a <parent> — they import it in <dependencyManagement>
        with scope=import type=pom. That keeps version decisions in one place and
        prevents transitive conflicts when multiple modules pull in the same library.
    -->
    <groupId>de.botpilot</groupId>
    <artifactId>bot-pilot-core-bom</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>bot-pilot-core-bom</name>
    <description>Centralized Bill of Materials for all bot-pilot modules</description>

    <properties>
        <spring-boot.version>3.5.0</spring-boot.version>
        <djl.version>0.33.0</djl.version>
        <jackson.version>2.19.0</jackson.version>
        <junit.version>5.11.4</junit.version>
        <mockito.version>5.14.2</mockito.version>
    </properties>

    <dependencyManagement>
        <dependencies>

            <!-- Spring Boot BOM: importing this lets us use all Spring Boot starters
                 without specifying versions for them individually. -->
            <dependency>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-dependencies</artifactId>
                <version>${spring-boot.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal modules: centralising internal artifact versions here means
                 parent/child POMs never hardcode a sibling version. -->
            <dependency>
                <groupId>de.botpilot</groupId>
                <artifactId>bot-pilot-faqs-domain</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>de.botpilot</groupId>
                <artifactId>bot-pilot-faqs-application</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>de.botpilot</groupId>
                <artifactId>bot-pilot-faqs-infrastructure-json</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>de.botpilot</groupId>
                <artifactId>bot-pilot-faqs-infrastructure-nlp</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>
            <dependency>
                <groupId>de.botpilot</groupId>
                <artifactId>bot-pilot-faqs-api</artifactId>
                <version>0.1.0-SNAPSHOT</version>
            </dependency>

            <!-- DJL core API — engine-agnostic; actual inference happens via engine jars below -->
            <dependency>
                <groupId>ai.djl</groupId>
                <artifactId>api</artifactId>
                <version>${djl.version}</version>
            </dependency>

            <!-- DJL HuggingFace tokenizers (Java port of the Rust tokenizer library) -->
            <dependency>
                <groupId>ai.djl.huggingface</groupId>
                <artifactId>tokenizers</artifactId>
                <version>${djl.version}</version>
            </dependency>

            <!-- DJL ONNX Runtime engine: supports dynamic input shapes unlike the PyTorch
                 TorchScript engine, which is traced with a fixed sequence length. -->
            <dependency>
                <groupId>ai.djl.onnxruntime</groupId>
                <artifactId>onnxruntime-engine</artifactId>
                <version>${djl.version}</version>
            </dependency>

            <!-- Jackson: already managed by spring-boot-dependencies, but listed here
                 explicitly so modules that don't pull a Spring starter can still use it. -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!-- JUnit 5 + Mockito (test scope) -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${mockito.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

</project>
